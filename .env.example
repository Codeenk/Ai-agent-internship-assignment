# Aster & Row support agent — environment configuration.
# Copy to .env and fill in your values. Never commit real credentials.

# Required: any OpenAI-compatible chat API key.
# Tested with Google AI Studio (Gemini / Gemma) and OpenAI; also works with
# OpenRouter, Groq, Together, or a local server.
OPENAI_API_KEY=your-key-here

# Optional: override the endpoint.
# Google AI Studio OpenAI-compatible endpoint:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OpenAI default (used when unset): https://api.openai.com/v1

# Optional: model names.
# MODEL_NAME=gemini-2.5-flash
# EMBEDDING_MODEL=text-embedding-3-small

# Optional: generation limits and retries.
# MAX_TOKENS=900
# LLM_TIMEOUT=90
# LLM_MAX_RETRIES=3

# Optional: print traces to the console as well as writing JSONL files.
# TRACE_CONSOLE=1
